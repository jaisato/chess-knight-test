{
    "name": "jaisato/chess-knight-test",
    "description": "Camino más corto del caballo de ajedrez (búsqueda en anchura) con arquitectura DDD sobre Symfony 7.4",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ramsey/uuid": "^4.9.4",
        "symfony/asset": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "7.4.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/runtime": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/phpstan": "^2.2.16",
        "phpstan/phpstan-phpunit": "^2.0.21",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^12.5.37",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4"
        }
    },
    "autoload": {
        "psr-4": {
            "Chess\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chess\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "@php bin/phpunit",
        "test:unit": "@php bin/phpunit --testsuite unit",
        "test:functional": "@php bin/phpunit --testsuite functional",
        "stan": [
            "@php bin/console cache:warmup --env=dev --no-interaction",
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "cs": "@php vendor/bin/php-cs-fixer check --diff",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix",
        "lint": [
            "@php bin/console lint:container",
            "@php bin/console lint:yaml config --parse-tags",
            "@php bin/console lint:twig templates"
        ],
        "check": [
            "@composer validate --strict",
            "@cs",
            "@stan",
            "@lint",
            "@test",
            "@composer audit --locked --abandoned=report"
        ]
    },
    "scripts-descriptions": {
        "test": "Toda la suite de PHPUnit",
        "test:unit": "Dominio y aplicación, sin arrancar el kernel",
        "test:functional": "El controlador a través del kernel (WebTestCase)",
        "stan": "Análisis estático (PHPStan); calienta antes el contenedor de dev que lee phpstan-symfony",
        "cs": "Comprueba el estilo sin tocar ficheros",
        "cs:fix": "Corrige el estilo",
        "lint": "Lint del contenedor, de la configuración YAML y de las plantillas Twig",
        "check": "Lo que ejecuta el CI, en orden y con el PHP local, salvo el umbral de cobertura: ese solo lo aplica el CI, porque necesita pcov o xdebug"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
